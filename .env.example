# Copy to .env for local development. Never commit real values.

# Canonical public origin (canonical URLs, hreflang, sitemap, email links).
PUBLIC_SITE_URL=http://localhost:4321

# Supabase project (Project Settings > API). The secret key is server-only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# One-time Owner setup at /admin/setup/. Use 32+ random characters; remove after setup.
OWNER_SETUP_TOKEN=

# Optional: Cloudflare Turnstile spam protection for the advertising form.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: show "Sign in with Google" after configuring Google in Supabase.
GOOGLE_LOGIN_ENABLED=false

# auto (database when configured, otherwise labelled sample content), demo, or supabase.
LAHZA_CONTENT_SOURCE=auto
