---
import { siteSettings } from '../config/site';
import type { Category, Lang } from '../content/types';
import { t } from '../i18n/strings';
import { paths } from '../i18n/routes';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

interface Props {
  lang: Lang;
  categories: Category[];
}
const { lang, categories } = Astro.props;
const { contact, leadership } = siteSettings;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-col">
      <Logo lang={lang} />
      <p class="footer-tagline">{siteSettings.tagline[lang]}</p>
      <h2 class="footer-leadership-title">{t(lang, 'footer.leadership')}</h2>
      <dl class="leadership footer-leadership">
        {leadership.map((person) => (
          <div><dt>{person.role[lang]}</dt><dd>{person.name[lang]}</dd></div>
        ))}
      </dl>
    </div>
    <div class="footer-col">
      <h2>{t(lang, 'footer.sections')}</h2>
      <ul class="footer-sections">
        {categories.map((category) => <li><a href={paths.category(lang, category)}>{category.name[lang]}</a></li>)}
      </ul>
    </div>
    <div class="footer-col">
      <h2>{t(lang, 'footer.links')}</h2>
      <ul>
        <li><a href={paths.advertise(lang)}>{t(lang, 'nav.advertise')}</a></li>
        <li><a href={paths.about(lang)}>{t(lang, 'nav.about')}</a></li>
        <li><a href={paths.privacy(lang)}>{t(lang, 'nav.privacy')}</a></li>
        <li><a href={paths.search(lang)}>{t(lang, 'nav.search')}</a></li>
      </ul>
    </div>
    <div class="footer-col footer-contact">
      <h2>{t(lang, 'footer.contact')}</h2>
      <ul>
        <li>{contact.phoneLabel}</li>
        <li><a href={contact.whatsappHref} rel="noopener noreferrer" target="_blank"><Icon name="whatsapp" /><span class="ltr">{contact.phone}</span></a></li>
        <li><a href={contact.telHref}><Icon name="phone" /><span class="ltr">{contact.phone}</span></a></li>
        <li><a href={contact.emailHref}><Icon name="mail" /><span class="ltr">{contact.email}</span></a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="container">
      <span>© {year} {siteSettings.name[lang]}. {t(lang, 'footer.rights')}</span>
    </div>
  </div>
</footer>
