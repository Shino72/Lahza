---
import type { Lang } from '../content/types';
import { paths } from '../i18n/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---
<a class="logo" href={paths.home(lang)} aria-label={lang === 'ar' ? 'لحظة - الرئيسية' : 'Lahza - Home'}>
  <svg class="logo__mark" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
    <circle cx="20" cy="20" r="17" fill="none" stroke="#fff" stroke-width="3.5" />
    <path d="M20 9v11l7 4" fill="none" stroke="#fff" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
    <circle cx="31.5" cy="8.5" r="4.5" fill="#c8102e" stroke="#0f2a4a" stroke-width="2" />
  </svg>
  <span class="logo__text">
    <span class="logo__ar">لحظة</span>
    <span class="logo__en">LAHZA</span>
  </span>
</a>
