---
import { at } from '../../admin/strings';
import AuthLayout from '../../layouts/AuthLayout.astro';
import { loadAccess } from '../../lib/server/access';
import { adminLang, PASSWORD_RULE } from '../../lib/server/admin';
import { logAuthEvent } from '../../lib/server/auth-log';

const lang = adminLang(Astro.cookies);
const supabase = Astro.locals.supabase!;
const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login/', 303);
let message: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const password = String(form.get('password') ?? '');
  const confirm = String(form.get('confirm') ?? '');
  if (password !== confirm) {
    message = at(lang, 'password.mismatch');
  } else if (!PASSWORD_RULE.test(password)) {
    message = at(lang, 'password.weak');
  } else {
    const { error } = await supabase.auth.updateUser({ password });
    if (error?.code === 'insufficient_aal') {
      return Astro.redirect('/admin/mfa/verify/?next=/admin/set-password/', 303);
    }
    if (error) {
      message = error.code === 'weak_password' ? at(lang, 'password.weak') : at(lang, 'password.failed');
    } else {
      await logAuthEvent(user.id, 'auth.password_set', {});
      const before = await loadAccess(supabase);
      if (before?.status === 'invited') {
        const { error: acceptError } = await supabase.rpc('accept_invitation');
        if (acceptError) {
          await supabase.auth.signOut();
          message = at(lang, 'password.expired');
        }
      }
      if (!message) {
        const access = await loadAccess(supabase);
        return Astro.redirect(access?.mfaRequired && access.aal !== 'aal2' ? '/admin/mfa/setup/' : '/admin/', 303);
      }
    }
  }
  Astro.response.status = 400;
}
---
<AuthLayout title={at(lang, 'password.title')}>
  <h1>{at(lang, 'password.title')}</h1>
  {message && <p class="flash flash--error" role="alert">{message}</p>}
  <p class="hint">{at(lang, 'password.rules')}</p>
  <form class="admin-form" method="post">
    <input type="email" name="username" value={user.email} autocomplete="username" hidden readonly />
    <div class="field">
      <label for="password">{at(lang, 'password.new')}</label>
      <input id="password" name="password" type="password" autocomplete="new-password" required minlength="12" maxlength="128" dir="ltr" />
    </div>
    <div class="field">
      <label for="confirm">{at(lang, 'password.confirm')}</label>
      <input id="confirm" name="confirm" type="password" autocomplete="new-password" required minlength="12" maxlength="128" dir="ltr" />
    </div>
    <button class="btn btn--primary" type="submit">{at(lang, 'password.submit')}</button>
  </form>
</AuthLayout>
