---
import { at } from '../../admin/strings';
import AuthLayout from '../../layouts/AuthLayout.astro';
import { adminLang, field } from '../../lib/server/admin';
import { allow, clientKey } from '../../lib/server/rate-limit';

const lang = adminLang(Astro.cookies);
let sent = false;
let limited = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = field(form, 'email', 254).toLowerCase();
  if (
    (await allow('reset-ip', clientKey(Astro.clientAddress), 5, 3600)) &&
    (await allow('reset-email', clientKey(email), 3, 3600))
  ) {
    // The response is the same whether or not the address exists.
    await Astro.locals.supabase!.auth.resetPasswordForEmail(email, {
      redirectTo: new URL('/admin/auth/confirm/', Astro.url).toString(),
    });
    sent = true;
  } else {
    limited = true;
    Astro.response.status = 429;
  }
}
---
<AuthLayout title={at(lang, 'forgot.title')}>
  <h1>{at(lang, 'forgot.title')}</h1>
  {sent ? (
    <p class="flash flash--ok" role="status">{at(lang, 'forgot.sent')}</p>
  ) : (
    <>
      {limited && <p class="flash flash--error" role="alert">{at(lang, 'login.limited')}</p>}
      <p>{at(lang, 'forgot.intro')}</p>
      <form class="admin-form" method="post">
        <div class="field">
          <label for="email">{at(lang, 'login.email')}</label>
          <input id="email" name="email" type="email" autocomplete="username" required maxlength="254" dir="ltr" />
        </div>
        <button class="btn btn--primary" type="submit">{at(lang, 'forgot.submit')}</button>
      </form>
    </>
  )}
  <p><a href="/admin/login/">{at(lang, 'forgot.back')}</a></p>
</AuthLayout>
