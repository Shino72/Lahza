---
import Icon from '../../components/Icon.astro';
import { contactLinks } from '../../config/site';
import { t } from '../../i18n/strings';
import { isLang, otherLang, paths } from '../../i18n/routes';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getRepository } from '../../lib/server/content';

const lang = Astro.params.lang;
if (!isLang(lang)) return new Response(null, { status: 404 });
const settings = await getRepository().settings();
const { contact, leadership } = settings;
const links = contactLinks(contact);
---
<BaseLayout lang={lang} title={t(lang, 'about.title')} description={t(lang, 'about.body')} path={paths.about(lang)} alternatePath={paths.about(otherLang(lang))}>
  <h1 class="page-title">{t(lang, 'about.title')}</h1>
  <div class="section panel panel--padded prose">
    <p>{t(lang, 'about.body')}</p>
    <h2>{t(lang, 'footer.leadership')}</h2>
    <dl class="leadership">
      {leadership.map((person) => (
        <div><dt>{person.role[lang]}</dt><dd>{person.name[lang]}</dd></div>
      ))}
    </dl>
    <h2>{t(lang, 'footer.contact')}</h2>
    <div class="contact-card__actions">
      <a class="button button--whatsapp" href={links.whatsapp} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" />{t(lang, 'ad.whatsapp')}</a>
      <a class="button button--call" href={links.tel}><Icon name="phone" /><span dir="ltr">{contact.phone}</span></a>
      <a class="button button--email" href={links.email}><Icon name="mail" />{t(lang, 'ad.email')}</a>
    </div>
    <p><a class="kicker" href={paths.advertise(lang)}>{t(lang, 'nav.advertise')}</a></p>
  </div>
</BaseLayout>
