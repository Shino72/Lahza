---
import SearchForm from '../../components/SearchForm.astro';
import StoryCard from '../../components/StoryCard.astro';
import { t } from '../../i18n/strings';
import { isLang, otherLang, paths } from '../../i18n/routes';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getRepository } from '../../lib/server/content';

const lang = Astro.params.lang;
if (!isLang(lang)) return new Response(null, { status: 404 });

const query = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 100);
const repo = getRepository();
const [results, categories] = await Promise.all([query ? repo.search(lang, query) : Promise.resolve([]), repo.categories()]);
const categoryById = new Map(categories.map((c) => [c.id, c]));
---
<BaseLayout lang={lang} title={t(lang, 'search.title')} description={t(lang, 'search.prompt')} path={paths.search(lang)} alternatePath={paths.search(otherLang(lang))} noindex>
  <h1 class="page-title">{t(lang, 'search.title')}</h1>
  <div class="section"><SearchForm lang={lang} id="search-page-q" value={query} /></div>
  <section class="results" aria-live="polite" data-search-results>
    {query === '' ? (
      <p class="page-intro">{t(lang, 'search.prompt')}</p>
    ) : results.length === 0 ? (
      <p class="empty">{t(lang, 'search.empty')}</p>
    ) : (
      <>
        <h2 class="results__count">{t(lang, 'search.resultsFor')} «{query}»: {results.length} {t(lang, 'search.count')}</h2>
        <div class="panel">
          {results.map((article) => <StoryCard article={article} category={categoryById.get(article.categoryId)} variant="row" />)}
        </div>
      </>
    )}
  </section>
</BaseLayout>
