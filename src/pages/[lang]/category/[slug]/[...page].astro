---
import Pagination from '../../../../components/Pagination.astro';
import StoryCard from '../../../../components/StoryCard.astro';
import { t } from '../../../../i18n/strings';
import { isLang, otherLang, paths } from '../../../../i18n/routes';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getRepository } from '../../../../lib/server/content';

const PER_PAGE = 12;
const { lang, slug } = Astro.params;
const pageParam = Astro.params.page;
if (!isLang(lang)) return new Response(null, { status: 404 });

const pageMatch = pageParam === undefined ? ['', '1'] : /^page\/([2-9]|[1-9][0-9]{1,3})$/.exec(pageParam);
if (!pageMatch) return new Response(null, { status: 404 });
const page = Number(pageMatch[1]);

const repo = getRepository();
const category = (await repo.categories()).find((c) => c.slug === slug);
if (!category) return new Response(null, { status: 404 });

const result = await repo.latest(lang, { page, perPage: PER_PAGE, categoryId: category.id });
if (page > result.totalPages) return new Response(null, { status: 404 });
const title = category.name[lang];
---
<BaseLayout
  lang={lang}
  title={page > 1 ? `${title} — ${t(lang, 'pagination.page')} ${page}` : title}
  description={category.description[lang]}
  path={paths.category(lang, category, page)}
  alternatePath={page === 1 ? paths.category(otherLang(lang), category) : undefined}
>
  <h1 class="page-title">{title}</h1>
  <p class="page-intro">{category.description[lang]}</p>
  {result.items.length === 0 ? (
    <p class="empty">{t(lang, 'category.empty')}</p>
  ) : (
    <div class="section">
      <StoryCard article={result.items[0]!} category={category} variant="lead" headingLevel={2} eager={page === 1} />
      {result.items.length > 1 && (
        <div class="panel list-grid section">
          {result.items.slice(1).map((article) => <StoryCard article={article} category={category} variant="row" headingLevel={2} />)}
        </div>
      )}
    </div>
  )}
  <Pagination lang={lang} page={result.page} totalPages={result.totalPages} hrefFor={(p) => paths.category(lang, category, p)} />
</BaseLayout>
