---
// Production redirects "/" to "/ar/" at the edge (vercel.json); this page is the static fallback.
import { paths } from '../i18n/routes';
const target = paths.home('ar');
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={new URL(target, Astro.site).toString()} />
    <title>لحظة | Lahza</title>
  </head>
  <body>
    <a href={target}>لحظة | Lahza</a>
  </body>
</html>
