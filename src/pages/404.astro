---
import SearchForm from '../components/SearchForm.astro';
import { t } from '../i18n/strings';
import { paths } from '../i18n/routes';
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout lang="ar" title={t('ar', 'notFound.title')} description={t('ar', 'notFound.body')} path="/404/" noindex>
  <div class="section panel panel--padded prose">
    <h1 class="page-title">{t('ar', 'notFound.title')}</h1>
    <p>{t('ar', 'notFound.body')}</p>
    <SearchForm lang="ar" id="notfound-q" />
    <p><a class="kicker" href={paths.home('ar')}>{t('ar', 'nav.home')}</a></p>
    <hr />
    <p lang="en" dir="ltr">{t('en', 'notFound.title')} — {t('en', 'notFound.body')} <a class="kicker" href={paths.home('en')}>{t('en', 'nav.home')}</a></p>
  </div>
</BaseLayout>
